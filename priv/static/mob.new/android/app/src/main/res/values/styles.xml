<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The boot look AppTheme builds on; values-v31/styles.xml adds the
         Android 12+ splash to it. Add your own theme items here, in
         MobBootTheme: on Android 12+ the AppTheme of values-v31 is used, so
         items on the AppTheme below would be lost there. -->
    <style name="MobBootTheme" parent="android:style/Theme.NoTitleBar">
        <!-- The launcher icon centred on white, or black in night mode
             (drawable/mob_window_background.xml): what the boot screen
             (StartupStatus) then draws over it. -->
        <item name="android:windowBackground">@drawable/mob_window_background</item>
        <!-- Edge to edge from the first frame. The system draws the starting
             window from this theme before the app runs; without these its
             background stops at the navigation bar, centring the icon higher
             than the edge-to-edge boot screen that replaces it. Dark bar
             icons on the white background, light ones in night mode
             (values-night/mob_window.xml). -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/mob_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/mob_light_system_bars</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="AppTheme" parent="MobBootTheme" />
</resources>
