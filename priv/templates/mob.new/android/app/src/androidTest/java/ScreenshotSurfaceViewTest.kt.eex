package <%= java_package %>

import android.graphics.BitmapFactory
import android.view.SurfaceHolder
import android.view.SurfaceView
import androidx.activity.ComponentActivity
import androidx.compose.foundation.background
import androidx.compose.foundation.layout.Box
import androidx.compose.foundation.layout.fillMaxSize
import androidx.compose.foundation.layout.size
import androidx.compose.ui.Modifier
import androidx.compose.ui.graphics.Color
import androidx.compose.ui.test.junit4.createAndroidComposeRule
import androidx.compose.ui.unit.dp
import androidx.compose.ui.viewinterop.AndroidView
import org.junit.Assert.assertEquals
import org.junit.Assert.assertNotNull
import org.junit.Assert.assertTrue
import org.junit.Rule
import org.junit.Test
import java.util.concurrent.CountDownLatch
import java.util.concurrent.TimeUnit

/**
 * MOB-422: a screenshot shows what a SurfaceView (a mob_scene3d viewport, a
 * camera preview, video) draws. The SurfaceView paints itself solid red, the
 * window around it white; the screenshot has to show red where the
 * SurfaceView is, where a copy of the window alone has the transparent hole
 * the SurfaceView is composited through.
 */
class ScreenshotSurfaceViewTest {
    @get:Rule
    val composeTestRule = createAndroidComposeRule<ComponentActivity>()

    @Test
    fun surfaceViewContentIsInTheScreenshot() {
        val painted = CountDownLatch(1)
        lateinit var surfaceView: SurfaceView

        composeTestRule.setContent {
            Box(Modifier.fillMaxSize().background(Color.White)) {
                AndroidView(
                    modifier = Modifier.size(160.dp),
                    factory = { ctx ->
                        SurfaceView(ctx).also { sv ->
                            surfaceView = sv
                            sv.holder.addCallback(PaintRed(painted))
                        }
                    },
                )
            }
        }
        assertTrue("the SurfaceView never drew", painted.await(5, TimeUnit.SECONDS))
        composeTestRule.waitForIdle()

        val at = IntArray(2)
        composeTestRule.runOnUiThread { surfaceView.getLocationInWindow(at) }
        val centre = 80 * composeTestRule.activity.resources.displayMetrics.density

        val png = MobBridge.screenshotOf(composeTestRule.activity, "png", 100, 1.0)
        assertNotNull("screenshot returned null", png)
        val shot = BitmapFactory.decodeByteArray(png, 0, png!!.size)
        val pixel = shot.getPixel((at[0] + centre).toInt(), (at[1] + centre).toInt())

        assertEquals("pixel %08x is not the SurfaceView's red".format(pixel), 0xFFFF0000.toInt(), pixel)
    }

    private class PaintRed(private val painted: CountDownLatch) : SurfaceHolder.Callback {
        override fun surfaceCreated(holder: SurfaceHolder) = Unit

        override fun surfaceChanged(holder: SurfaceHolder, format: Int, width: Int, height: Int) {
            val canvas = holder.lockCanvas() ?: return
            canvas.drawColor(android.graphics.Color.RED)
            holder.unlockCanvasAndPost(canvas)
            painted.countDown()
        }

        override fun surfaceDestroyed(holder: SurfaceHolder) = Unit
    }
}
